{
  "version": 2,
  "framework": null,
  "functions": {
    "api/index.ts": {
      "includeFiles": "packages/shared/**"
    }
  },
  "rewrites": [
    {
      "source": "/v1/:match*",
      "destination": "/api/index"
    },
    {
      "source": "/health",
      "destination": "/api/index"
    }
  ]
}
