# ==========================================
# MESAYA — ENTORNO Y PRODUCCIÓN (VERCEL + SUPABASE)
# ==========================================

# 1. BASE DE DATOS (SUPABASE POSTGRESQL)
# Connection Pooling (pgbouncer puerto 6543)
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_ID].supabase.co:6543/postgres?pgbouncer=true"
# Conexión directa para migraciones Prisma (puerto 5432)
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_ID].supabase.co:5432/postgres"

# 2. SEGURIDAD Y CIFRADO
JWT_SECRET="REPLACE_WITH_RANDOM_32+_CHAR_SECRET"
ENCRYPTION_SECRET_KEY="REPLACE_WITH_A_DIFFERENT_RANDOM_32+_CHAR_SECRET"

# 3. BACKEND API (FASTIFY)
PORT=3000
HOST="0.0.0.0"
CORS_ORIGIN="https://app.example.com,https://admin.example.com"

# 4. FRONTENDS (VERCEL VITE VARIABLES)
VITE_API_URL="https://api.mesaya.app/v1"
# URL base de la app comensal para generación canónica de QR y previsualizaciones
VITE_CLIENT_URL="https://app.mesaya.app"
# Alias de VITE_CLIENT_URL para entornos donde se distingue cliente web
VITE_CLIENT_WEB_URL="https://app.mesaya.app"
# Habilita botones de acceso rápido demo en el login de personal (staff-panel)
VITE_DEMO_MODE="false"
# Habilita el formulario de autoregistro público en el panel administrativo
VITE_PUBLIC_ONBOARDING_ENABLED="false"

# 5. ALTA PÚBLICA (apagada salvo habilitación explícita)
PUBLIC_ONBOARDING_ENABLED="false"
# Alias legado aceptado durante la migración de instalaciones existentes:
# PILOT_PUBLIC_ONBOARDING_ENABLED="false"

# 5b. AISLAMIENTO DE INSTANCIA
# Desarrollo compartido: MULTI_TENANT. Cada local instalado: SINGLE_RESTAURANT
# y el ID raíz creado por el bootstrap. Nunca commitear el valor real.
MESAYA_INSTANCE_MODE="MULTI_TENANT"
MESAYA_INSTANCE_RESTAURANT_ID=""

# 6. IA ACOTADA (opcional; sin estas claves las funciones IA responden contenidas)
# ENABLE_AI_FEATURES="false"
# GEMINI_API_KEY=""

# 7. MIGRACIONES/CI (sólo entorno del operador o secretos del CI; nunca en el repo)
# MESAYA_PG_DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres"
# MESAYA_PG_DIRECT_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres"
