# ==========================================
# MesaYA - Configuración de Entorno Supabase + Vercel
# ==========================================

# 1. Base de Datos en Supabase (PostgreSQL)
# DATABASE_URL: Usar la URL con Transaction Pooler (puerto 6543) para Serverless / Vercel
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# DIRECT_URL: Usar la URL de conexión directa (puerto 5432) para migraciones de Prisma
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# 2. Configuración del Servidor y Seguridad
PORT=3000
NODE_ENV="production"
JWT_SECRET="REPLACE_WITH_RANDOM_32+_CHAR_SECRET"
ENCRYPTION_SECRET_KEY="REPLACE_WITH_A_DIFFERENT_RANDOM_32+_CHAR_SECRET"
CORS_ORIGIN="https://mesaya-client.vercel.app,https://mesaya-staff.vercel.app,https://mesaya-admin.vercel.app"

# 3. Supabase Extras (Opcional si usas Supabase Storage o Auth)
SUPABASE_URL="https://[PROJECT_REF].supabase.co"
SUPABASE_ANON_KEY="[YOUR-ANON-KEY]"
SUPABASE_SERVICE_ROLE_KEY="[YOUR-SERVICE-ROLE-KEY]"

# 4. URLs de Aplicaciones
CLIENT_WEB_URL="https://mesaya-client.vercel.app"
STAFF_PANEL_URL="https://mesaya-staff.vercel.app"
ADMIN_DASHBOARD_URL="https://mesaya-admin.vercel.app"
