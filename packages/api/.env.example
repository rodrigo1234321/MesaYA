# Configuración de Entorno de API MesaYA

NODE_ENV=development
PORT=3000
HOST="0.0.0.0"

# Base de datos (SQLite en dev; PostgreSQL Supabase en prod)
DATABASE_URL="file:./dev.db"
# DIRECT_URL="postgresql://user:pass@host:5432/dbname"

# Secretos de autenticación y cifrado (deben ser distintos en producción, mín 32 caracteres)
JWT_SECRET="development-jwt-secret-mesaya-super-secure-key"
ENCRYPTION_SECRET_KEY="development-encryption-secret-key-min-32-chars-long"

# Huella de PIN de colaboradores (E04)
# Permite rotar el secreto HMAC sin invalidar credenciales ni mezclar con tokens de pago.
STAFF_PIN_PEPPER="development-staff-pin-pepper-current"
# Durante una rotación, defina la clave previa para permitir login y rollover automático transparente:
# STAFF_PIN_PEPPER_PREVIOUS="development-staff-pin-pepper-previous"

# Instancia y CORS
MESAYA_INSTANCE_MODE=MULTI_TENANT
# MESAYA_INSTANCE_RESTAURANT_ID=""
CORS_ORIGIN="http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:3000"

# Alta pública (deshabilitada por defecto)
PUBLIC_ONBOARDING_ENABLED="false"

# IA Acotada (opcional; si está vacía las funciones de sommelier e IA responden contenidas)
# GEMINI_API_KEY=""
