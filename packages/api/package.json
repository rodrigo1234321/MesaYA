{
  "name": "@mesaya/api",
  "version": "1.0.0",
  "main": "dist/index.js",
  "scripts": {
    "dev": "node ../../scripts/run-tsx.mjs watch src/index.ts",
    "build": "prisma generate && tsc",
    "start": "node dist/index.js",
    "generate:sqlite": "node ../../scripts/prisma-generate.mjs sqlite",
    "generate:postgres": "node ../../scripts/prisma-generate.mjs postgres",
    "prisma:generate": "npm run generate:sqlite",
    "prisma:postgres:migration:generate": "node ../../scripts/generate-postgres-migration.mjs init",
    "prisma:postgres:migrate": "node ../../scripts/postgres-migrate.mjs deploy",
    "test:postgres": "node ../../scripts/test-postgres.mjs",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "node ../../scripts/run-tsx.mjs prisma/seed.ts",
    "prisma:supabase:generate": "npm run generate:postgres",
    "prisma:supabase:push": "prisma db push --schema=prisma/schema.supabase.prisma",
    "prisma:supabase:migrate": "prisma migrate dev --schema=prisma/schema.supabase.prisma",
    "prisma:supabase:seed": "node ../../scripts/run-tsx.mjs prisma/seed.ts",
    "test": "node ../../scripts/test-local.mjs"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/jwt": "^8.0.1",
    "@mesaya/shared": "*",
    "@prisma/client": "^5.14.0",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "fastify": "^4.27.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.12.12",
    "prisma": "^5.14.0",
    "tsx": "^4.10.5",
    "typescript": "^5.4.5",
    "vitest": "^4.1.11"
  }
}
